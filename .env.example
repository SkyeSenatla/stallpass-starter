# Copy to .env.local and fill in. .env.local is never committed.

# Where the fake API runs (npm run api). Server-only: the browser never calls it.
API_BASE_URL=http://localhost:4200

# 32 random bytes, base64. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
